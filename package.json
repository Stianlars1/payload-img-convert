{
  "name": "payload-img-convert",
  "version": "1.0.0",
  "description": "Payload CMS plugin that automatically converts and resizes uploaded images to WebP, AVIF, or other formats using Sharp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "import": "./dist/exports/types.js",
      "types": "./dist/exports/types.d.ts"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rimraf dist *.tsbuildinfo",
    "postbuild": "rm -rf node_modules/payload node_modules/@payloadcms",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "Stian Larsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stianlars1/payload-img-convert.git"
  },
  "homepage": "https://github.com/stianlars1/payload-img-convert#readme",
  "bugs": {
    "url": "https://github.com/stianlars1/payload-img-convert/issues"
  },
  "devDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.0",
    "@types/react": "^19.2.14",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.0.0"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "webp",
    "avif",
    "image",
    "converter",
    "resize",
    "sharp",
    "optimization"
  ],
  "license": "MIT"
}
